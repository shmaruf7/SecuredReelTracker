<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Glow Shadow behind the Shield -->
    <path
        android:fillColor="#1000F2FE"
        android:pathData="M 54,26 C 36,26 30,32 30,48 C 30,68 54,82 54,82 C 54,82 78,68 78,48 C 78,32 72,26 54,26 Z" />

    <!-- Main Outer Shield Badge -->
    <path
        android:pathData="M 54,29 C 38,29 33,35 33,50 C 33,68 54,80 54,80 C 54,80 75,68 75,50 C 75,35 70,29 54,29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="225"
                android:startColor="#00F2FE"
                android:endColor="#4FACFE"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Inner Dark Accent Shield Layer -->
    <path
        android:fillColor="#0D111A"
        android:pathData="M 54,33 C 41,33 37,38 37,50 C 37,64 54,75 54,75 C 54,75 71,64 71,50 C 71,38 67,33 54,33 Z" />

    <!-- Central Minimalist Pause & Shield Ring Emblem (Symbolizing Reel Control & Boundaries) -->
    <!-- Left Pause Bar / Boundary Pillar -->
    <path
        android:pathData="M 46,45 L 46,61">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startColor="#00F2FE"
                android:endColor="#00D2FF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <path
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M 46,45 L 46,61">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startColor="#00F2FE"
                android:endColor="#00D2FF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Right Pause Bar / Boundary Pillar -->
    <path
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M 62,45 L 62,61">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startColor="#00F2FE"
                android:endColor="#00D2FF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Central Glowing Control Circle -->
    <path
        android:pathData="M 54,53 A 4,4 0 1,1 54,52.99 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#00F2FE"
                android:endColor="#00D2FF"
                android:type="linear" />
        </aapt:attr>
    </path>

</vector>
